    "data:sync-depp-bac": "tsx src/scripts/data/sync-depp-bac.ts",
    "data:sync-georisques": "tsx src/scripts/data/sync-georisques.ts",
    "data:sync-atmo": "tsx src/scripts/data/sync-atmo.ts",
    "data:sync-region-finances": "tsx src/scripts/data/sync-region-finances.ts",
    "data:sync-itdd": "tsx src/scripts/data/sync-itdd.ts",
