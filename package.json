    "inngest": "^4.5.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.45.0",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "rss-parser": "^3.13.0",
    "tar": "^7.5.19",
    "unzipper": "^0.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
